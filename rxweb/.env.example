# Copy to .env.local and fill in your own keys. All services are free-tier.
# Vite only exposes vars prefixed with VITE_ to the browser.

# Google Gemini — free tier: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.5-flash

# openFDA — free, key optional (raises rate limit):
# https://open.fda.gov/apis/authentication/
VITE_OPENFDA_API_KEY=

# RxNorm / RxClass — free, no key required (no env var needed).
