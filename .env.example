# Copy this file to .env and fill in your own keys.
# All services below have a free tier / free access.

# Google Gemini — free tier, get key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# openFDA — free, key optional (raises rate limit): https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=
OPENFDA_BASE_URL=https://api.fda.gov

# RxNorm / RxClass — free, no key required
RXNORM_BASE_URL=https://rxnav.nlm.nih.gov/REST

# Supabase — free tier, keys from Project Settings > API
SUPABASE_URL=
SUPABASE_SECRET_KEY=
